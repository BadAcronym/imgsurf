#!/bin/bash

if [[ ! -d "./obj/" ]]
then
    mkdir ./obj/
fi

if [[ ! -d "./build/" ]]
then
    mkdir ./build/
fi

if [[ ! -d "./bin/" ]]
then
    mkdir ./bin/
fi

echo ""
echo -e "\033[36mcompiling imgsurf...\033[0m"
echo ""

premake5 ecc
premake5 gmake

if [[ $1 = "debug" ]]
then
    pushd ./build/ > /dev/null
    make config=debug_linux
elif [[ $1 = "release" ]]
then
    pushd ./build/ > /dev/null
    make config=release_linux
elif [[ $1 = "asan" ]]
then
    pushd ./build/ > /dev/null
    make config=asan_linux
else
    echo -e "\033[31m\nERROR: invalid make config: $1.\033[0m"
    exit -2;
fi

if [[ $? != 0 ]]
then
    echo -e "\033[31m\nERROR: failed to compile.\n\033[0m"
    exit -1
fi

echo -e "\n"

if [[ $2 = "--compile-only" ]]
then
    exit 0
fi

popd > /dev/null

chmod +x ./bin/$1/imgsurftest
./bin/$1/imgsurftest
